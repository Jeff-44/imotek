# Copy to .env.prod and replace every value. Never commit .env.prod.
COMPOSE_PROJECT_NAME=imotek-prod

POSTGRES_DB=imotek
POSTGRES_USER=imotek
# At least 24 random characters, e.g.: openssl rand -base64 32
POSTGRES_PASSWORD=change-me

# Host name(s) the API answers to, separated by ";" (e.g. imotek.ht;www.imotek.ht)
ALLOWED_HOSTS=imotek.example

# Where the web container listens on the host. Keep 127.0.0.1 when a reverse proxy
# on the same machine terminates TLS; use 0.0.0.0 only behind a firewall/load balancer.
WEB_BIND=127.0.0.1
WEB_PORT=8080

# First start only: creates the administrator, then remove both lines.
ADMIN_EMAIL=
ADMIN_PASSWORD=
